<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Untuk Orang Kesayanganku 🤍</title>

  <style>
    body {
      background: radial-gradient(circle at top, #1b1b2f, #0f0f1a);
      font-family: 'Segoe UI', sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
      color: #fff;
      overflow: hidden;
    }

    /* PASSWORD SCREEN */
    .lock-screen {
      position: fixed;
      inset: 0;
      background: radial-gradient(circle at top, #1b1b2f, #0f0f1a);
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 999;
    }

    .lock-box {
      background: rgba(255,255,255,0.05);
      padding: 30px;
      border-radius: 20px;
      text-align: center;
      box-shadow: 0 0 40px rgba(255, 182, 193, 0.25);
      backdrop-filter: blur(10px);
      animation: fadeIn 1.5s ease;
    }

    .lock-box h2 {
      color: #ffb6c1;
      margin-bottom: 10px;
    }

    .lock-box p {
      font-size: 14px;
      opacity: 0.8;
      margin-bottom: 20px;
    }

    .lock-box input {
      padding: 12px;
      width: 220px;
      border-radius: 30px;
      border: none;
      text-align: center;
      font-size: 16px;
      outline: none;
    }

    .lock-box button {
      margin-top: 15px;
      padding: 12px 30px;
      border: none;
      border-radius: 30px;
      background: linear-gradient(135deg, #ff758c, #ff7eb3);
      color: white;
      font-size: 15px;
      cursor: pointer;
      box-shadow: 0 0 20px rgba(255, 117, 140, 0.6);
    }

    /* MAIN CARD */
    .card {
      display: none;
      background: rgba(255,255,255,0.05);
      padding: 30px;
      border-radius: 20px;
      max-width: 650px;
      box-shadow: 0 0 40px rgba(255, 182, 193, 0.25);
      backdrop-filter: blur(10px);
      animation: fadeIn 2s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    h1 {
      text-align: center;
      margin-bottom: 5px;
      color: #ffb6c1;
    }

    .subtitle {
      text-align: center;
      font-size: 13px;
      opacity: 0.75;
      margin-bottom: 20px;
    }

    #text {
      font-size: 16px;
      line-height: 1.8;
      white-space: pre-wrap;
    }

    .cursor {
      display: inline-block;
      width: 8px;
      background: #ffb6c1;
      margin-left: 3px;
      animation: blink 1s infinite;
    }

    @keyframes blink {
      0%, 50%, 100% { opacity: 1; }
      25%, 75% { opacity: 0; }
    }

    .btn-love {
      display: block;
      margin: 30